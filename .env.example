# Gemini API key from https://aistudio.google.com/apikey (server-side only, never exposed to the browser).
# Leave empty to run fully offline: the rule engine still builds every plan, and the
# assistant and ideas fall back to the built-in parser and curated ideas.
GEMINI_API_KEY=

# Optional: comma-separated model fallback chain (first is tried first).
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite

# Optional: assistant and ideas requests per client per minute (default 12).
# RATE_LIMIT_PER_MINUTE=12
